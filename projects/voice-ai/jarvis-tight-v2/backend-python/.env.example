# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# Whisper (STT)
WHISPER_MODEL=base

# Piper (TTS) - absolute path to a downloaded .onnx voice model
PIPER_VOICE=en_US-lessac-medium.onnx

# Node gateway (used by tools.py for calendar calls)
GATEWAY_URL=http://localhost:5000

# Local notes storage
NOTES_FILE=./data/notes.json

# Optional shared secret the Node gateway must send as X-API-Key.
# Leave unset to keep the original "trusted local network" behavior.
SERVICE_API_KEY=

# Comma-separated list, or "*" for any origin (default)
ALLOWED_ORIGINS=*
