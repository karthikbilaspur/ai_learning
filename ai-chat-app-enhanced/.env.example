# Required
OPENAI_API_KEY=sk-proj-...

# Model used for chat
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL for persistent conversations and usage tracking
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ai_chat?sslmode=require

# Optional production rate limiting with Upstash Redis
# If omitted, the app falls back to an in-process limiter for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App limits
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_TOKENS=12000
MAX_MESSAGE_CHARS=30000
